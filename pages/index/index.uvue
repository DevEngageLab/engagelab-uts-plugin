<template>
	<view>
		
		<button type="primary" @click="testConfigGoogleAction">testConfigGoogleAction</button>
		<button type="primary" @click="getAuthIOS">getAuthIOS</button>
		<button type="primary" @click="initPushAction">initPushAction</button>
		<button type="primary" @click="openDebugMode">openDebugMode</button>
		<button type="primary" @click="closeDebugMode">closeDebugMode</button>
		<button type="primary" @click="setBadgeAction">setBadgeAction</button>
		<button type="primary" @click="addEventCallBack">addEventCallBack</button>
		<button type="primary" @click="registrationId">registrationId</button>
		<button type="primary" @click="addTagsAction">addTags</button>
		<button type="primary" @click="setTagsAction">setTags</button>
		<button type="primary" @click="getAllTagsAction">getAllTags</button>
		<button type="primary" @click="deleteTagsAction">deleteTags</button>
		<button type="primary" @click="cleanTagsAction">cleanTags</button>
		<button type="primary" @click="vaildTagAction">vaildTag</button>
		<button type="primary" @click="setAliasAction">setAlias</button>
		<button type="primary" @click="deleteAliasAction">deleteAlias</button>
		<button type="primary" @click="getAliasAction">getAlias</button>
		<!-- #ifdef APP-ANDROID -->
		<button type="primary" @click="requestVivoSubscribeAction">vivo 通知渠道订阅</button>
		<!-- #endif -->
	</view>
</template>

<script>
	// #ifdef APP-IOS 
	import { getNotiAuth } from "../../uni_modules/engagelab-mtpush"
	// #endif
	// #ifdef APP-ANDROID
	import { requestVivoSubscribeChannel } from "../../uni_modules/engagelab-mtpush";
	// #endif
	import {  
		InitPushParams, 
		CollectControl, 
		setCollectControl, 
		initPush, 
		setDebugMode, 
		addEventCallBack, 
		EventCallBack, 
		EventCallBackParams, 
		addTags, 
		setTags,
		deleteTags,
		cleanTags,
		getAllTags,
		validTag,
		setBadge, 
		SetBadge, 
		getRegistrationId, 
		setUserAlias, 
		deleteUserAlias, 
		getUserAlias,
		testConfigGoogle } from "../../uni_modules/engagelab-mtpush";
	
	export default {
		data() {
			return {
				title: 'Hello'
			}
		},
		onLoad() {

		},
		methods: {
			requestVivoSubscribeAction() {
				// #ifdef APP-ANDROID
				// 初始化并开启通知权限后，将 ID 替换为 vivo 后台的通知渠道 ID。
				// 最终结果由 addEventCallBack 的 onCommandResult (cmd 2013) 返回。
				requestVivoSubscribeChannel(["your_vivo_channel_id"]);
				// #endif
			},
			testConfigGoogleAction() {
				// 线上环境请不要调用该函数，仅安卓生效
				testConfigGoogle(true);
			},
			getAuthIOS() {
				// #ifdef APP-IOS 
				getNotiAuth();
				// #endif
			},
			initPushAction() {
				// Android 使用 manifestPlaceholders.json 中配置的 AppKey。
				const options = {
					appkey: 'your_ios_appkey',
					channel: 'test',
					isProduction: false
				} as InitPushParams;
				initPush(options);
			},
			// initPushAction() {
			// 	console.log('initPush');
				
			// 	// // #ifdef APP-ANDROID
			// 	// 	let control = {
			// 	// 		gaid: false,
			// 	// 		// aid: false  // 注意：aid 字段自 Android SDK 5.4.0 起已废弃，AndroidId 默认不再采集
			// 	// 	} as CollectControl;
			// 	// 	setCollectControl(control);
			// 	// // #endif
				
			// 	// appkey对iOS生效，安卓的appkey需要配置在manifestPlaceholders.json中
			// 	let options = {
			// 		appkey: '5645a6e0c6ef00bb71facf21',
			// 		channel: 'test',
			// 		isProduction : false	
			// 	} as InitPushParams;
			// 	initPush(options);
			// },
			openDebugMode() {
				setDebugMode(true)
			},
			closeDebugMode() {
				setDebugMode(false)
			},
			setBadgeAction() {
				const badge: number = 2;
				setBadge(badge);
			},
			addEventCallBack() {
				console.log('initPush');
				let eventCallBack = {
					callback: (res: EventCallBack) => {
						console.log(res);

					}
				} as EventCallBackParams;
				addEventCallBack(eventCallBack);
			},
			registrationId() {
				const rid = getRegistrationId();
				console.log('getRegistrationId:');
				console.log(rid);
			},
			addTagsAction(){
				addTags(1, ["apple", "banana", "orange"])
			},
			setTagsAction(){
				setTags(2, ["apple", "banana", "orange"])
			},
			getAllTagsAction(){
				getAllTags(3);
			},
			deleteTagsAction(){
				deleteTags(4, ["banana"]);
			},
			cleanTagsAction(){
				cleanTags(5);
			},
			vaildTagAction(){
				validTag(6, "orange");
			},
			setAliasAction(){
				setUserAlias("snsn", 2);
			},
			deleteAliasAction(){
				deleteUserAlias(3)
			},
			getAliasAction(){
				getUserAlias(4);
			}
			
		}
		
	}
</script>

